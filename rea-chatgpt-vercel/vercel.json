{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?connector_key=:key"
    }
  ],
  "functions": {
    "server.mjs": {
      "maxDuration": 300,
      "includeFiles": "node_modules/rea-agents/**"
    }
  }
}
